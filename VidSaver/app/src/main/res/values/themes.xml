<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose owns the in-app theming (see ui/theme/Theme.kt). This XML theme only
      covers the window before the first frame, so it stays minimal.
    -->
    <style name="Theme.VidSaver" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
